# ─── Obrigatórias ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:senha@host:5432/estoqueflow"
JWT_SECRET="troque-por-uma-string-aleatoria-de-32-caracteres"

# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
HOST=::   # em plataformas com rede IPv6 (Railway/Fly) use :: para aceitar IPv4 e IPv6
CORS_ORIGIN=*

# ─── Redundância Google Sheets (opcional) ───────────────────────────────────
# ID da planilha: https://docs.google.com/spreadsheets/d/<ESTE_PEDACO>/edit
GOOGLE_SHEET_ID="1yOGaeneRM-PjSlxnpUKZ7QoLvMOOMAO29k0wSITlQnE"
# Cole o JSON inteiro da Service Account (uma linha só)
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Alternativa ao JSON acima:
# GOOGLE_CLIENT_EMAIL="estoqueflow@projeto.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SHEET_SYNC_ENABLED=true
SHEET_SYNC_INTERVAL_MS=30000
SHEET_GUARD_INTERVAL_MS=300000

# ─── Demo ───────────────────────────────────────────────────────────────────
SEED_DEMO=true
DEMO_EMAIL=demo@estoqueflow.app
DEMO_PASSWORD=estoque2026
